{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fitcore:d05:run:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evaluation_time", "runs"],
  "properties": {
    "schema_version": {"const": "d05.input.v1"},
    "evaluation_time": {"type": ["string", "null"], "format": "date-time"},
    "runs": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["source_commit", "dataset_version", "model_provider", "model_version", "schema_version", "environment"],
        "properties": {
          "source_commit": {"type": "string", "minLength": 1},
          "dataset_version": {"type": "string", "minLength": 1},
          "model_provider": {"type": "string", "minLength": 1},
          "model_version": {"type": "string", "minLength": 1},
          "schema_version": {"const": "d05.input.v1"},
          "environment": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
          "mode": {"enum": ["synthetic", "text_simulation", "replay", "real_audio"]},
          "split": {"type": "string", "minLength": 1},
          "reviewer": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$comment": "Empty runs plus null evaluation_time is the public empty template. Actual input requires populated versions and timezone-aware time. Non-synthetic source commits must resolve locally to the exact full Git SHA."
}
