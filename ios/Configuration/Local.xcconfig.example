// Copy to Local.xcconfig. That file is ignored by Git.
// Set your own Bundle ID and choose your Personal Team in Xcode.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.fitcore.demo
DEVELOPMENT_TEAM =
// xcconfig treats // as a comment; use /$()/ to preserve the URL.
// HTTPS only. This URL is visible in the built app; it is NOT a secret.
FITCORE_API_BASE_URL = https:/$()/your-api.example.com
FITCORE_RECORDER_MODE = mock
// Set backend to use real typed-text analysis with the saved Fitcore backend connection.
FITCORE_ANALYSIS_MODE = mock
// Do not put ASR, LLM or Anker app_key credentials in any iOS configuration.
