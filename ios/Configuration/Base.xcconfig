PRODUCT_NAME = Fitcore
PRODUCT_BUNDLE_IDENTIFIER = com.example.fitcore
MARKETING_VERSION = 0.3.1
CURRENT_PROJECT_VERSION = 8
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Fitcore/Resources/Info.plist
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_USER_SCRIPT_SANDBOXING = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
CLANG_ENABLE_MODULES = YES
SWIFT_EMIT_LOC_STRINGS = YES
FITCORE_RECORDER_MODE = mock
FITCORE_ANALYSIS_MODE = mock
// No backend URL or credentials are required to run the local Mock shell.
FITCORE_API_BASE_URL =
